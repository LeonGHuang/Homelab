{
        // vim
        "vim.foldfix": true,
        "editor.lineNumbers": "relative",
        "vim.useSystemClipboard": true,
	"editor.cursorBlinking": "solid",

        // vim keybinds
        "vim.insertModeKeyBindings": [
                {
                "before":["j", "k"],
                "after": ["<Esc>"]
                },
                {
                "before":["k", "j"],
                "after": ["<Esc>"]
                }
        ],


        // vscode
        "editor.autoIndentOnPaste": true,
        "jupyter.interactiveWindow.textEditor.executeSelection": true,
        "task.allowAutomaticTasks": "on",
        "files.autoSave": "afterDelay",
	"editor.parameterHints.enabled": true,

	"editor.hover.enabled": "on",
	"editor.suggestOnTriggerCharacters": true,
	


	// highlight settings
	"editor.occurrencesHighlight": "off",
	"editor.selectionHighlight": true,
	"workbench.colorCustomizations": {
		"editor.lineHighlightBackground": "#a06cff18"
	},


        // good coding practises
        "editor.tabSize": 8,
        "editor.autoIndent": "full",
        "editor.inlineSuggest.enabled": false,
        "editor.autoClosingBrackets": "never",
        "editor.autoClosingOvertype": "never",
        "editor.autoClosingQuotes": "never",

        // workspace debloat
        "breadcrumbs.enabled": false,
        "chat.titleBar.openInAgentsWindow.enabled": false,
        "editor.minimap.enabled": false,
        "window.commandCenter": false,
        "workbench.browser.showInTitleBar": true,
        "chat.viewSessions.orientation": "stacked",
        "workbench.sideBar.location": "right",
        "workbench.activityBar.location": "top", 
        "terminal.integrated.tabs.location": "left",
        "window.menuBarVisibility": "toggle",

        // theme
        "workbench.colorTheme": "Catppuccin Macchiato",
        "workbench.iconTheme": "vs-nomo-dark",
        "editor.foldingHighlight":false,
        "editor.tokenColorCustomizations": {
                "textMateRules": [
                {
                "scope": "storage.type.string.python",
                "settings": { "foreground": "#E06C75" }
                }
                ]
        },
        "python.languageServer": "None",

        // windsurf pyright: hide grayed-out inferred types like "int | Unknown"
        "windsurfPyright.analysis.inlayHints.variableTypes": false,
        "editor.inlineSuggest.edits.allowCodeShifting": "never",
        "editor.inlineSuggest.edits.renderSideBySide": "never",
        "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click"
}
